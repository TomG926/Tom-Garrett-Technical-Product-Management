<header class="sticky top-0 z-40 border-b border-ink-100/80 bg-paper/85 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-4 sm:px-8" aria-label="Primary">
    <%= link_to root_path, class: "group flex items-baseline gap-2.5" do %>
      <span class="font-display text-[0.95rem] font-700 tracking-tight text-ink-950 font-semibold">Tom&nbsp;Garrett</span>
      <span class="hidden text-[0.72rem] text-ink-400 sm:inline"><%= contact[:role] %></span>
      <span class="hidden text-[0.72rem] text-ink-300 lg:inline">· <%= contact[:strapline] %></span>
    <% end %>

    <div class="ml-auto flex items-center gap-5 text-[0.85rem] font-medium sm:gap-7">
      <%= link_to "Work", work_index_path,
            class: "link-underline #{current_page?(work_index_path) ? 'text-ink-950' : 'text-ink-500 hover:text-ink-950'}" %>
      <%= link_to "About", about_path,
            class: "link-underline #{current_page?(about_path) ? 'text-ink-950' : 'text-ink-500 hover:text-ink-950'}" %>
      <a href="<%= contact[:cv] %>" download
         class="inline-flex items-center gap-1.5 rounded-full bg-ink-950 px-3.5 py-1.5 text-[0.8rem] font-medium text-paper transition hover:bg-ink-700">
        CV
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M10 3.5v10m0 0 3.5-3.5M10 13.5 6.5 10M4 16.5h12" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </nav>
</header>
