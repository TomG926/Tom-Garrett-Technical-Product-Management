<%# Large horizontal card. `reverse` flips the image to the right so a list of
    them alternates. The project's own accent is the only colour on the card. %>
<article class="group relative" style="--accent: <%= case_study.accent %>">
  <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14 <%= 'lg:[&>*:first-child]:order-2' if reverse %>">
    <%= link_to work_path(case_study), class: "block overflow-hidden rounded-lg border border-ink-100 bg-panel shadow-[0_1px_2px_rgba(11,13,16,.05),0_18px_40px_-28px_rgba(11,13,16,.5)] transition duration-500 group-hover:-translate-y-1 group-hover:shadow-[0_1px_2px_rgba(11,13,16,.06),0_26px_50px_-28px_rgba(11,13,16,.55)]" do %>
      <%# Screenshots vary from wide to nearly square; a fixed ratio anchored to the
          top gives every card the same window onto its product. %>
      <img src="<%= case_study.cover_path %>" alt="<%= case_study.cover_alt %>"
           loading="lazy" decoding="async"
           class="block aspect-[16/10] w-full object-cover object-left-top">
    <% end %>

    <div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="eyebrow" style="color: var(--accent)"><%= case_study.kicker %></span>
        <span class="text-ink-200">/</span>
        <span class="font-mono text-[0.7rem] text-ink-400"><%= case_study.period %></span>
      </div>

      <h3 class="mt-3 font-display text-[1.7rem] font-semibold leading-tight text-ink-950 sm:text-[2rem]">
        <%= link_to case_study.title, work_path(case_study), class: "after:absolute after:inset-0 after:content-['']" %>
      </h3>

      <p class="mt-3 max-w-lg text-[1.02rem] leading-relaxed text-ink-500"><%= case_study.summary %></p>

      <dl class="mt-6 grid max-w-lg grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4">
        <% case_study.stats.each do |value, label| %>
          <div>
            <dt class="sr-only"><%= label %></dt>
            <dd>
              <span class="block font-display text-[1.45rem] font-semibold leading-none tabular-nums text-ink-950"><%= value %></span>
              <span class="mt-1.5 block text-[0.7rem] leading-snug text-ink-400"><%= label %></span>
            </dd>
          </div>
        <% end %>
      </dl>

      <%# Styled as a button but left as a span: the title link already covers the
          whole card via ::after, so a second anchor here would duplicate the target
          and give screen readers two links to the same study. %>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-paper px-4 py-2 text-[0.88rem] font-medium text-ink-950 transition duration-300 group-hover:border-ink-950 group-hover:bg-ink-950 group-hover:text-paper">
          Read the case study
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M4 10h11m0 0-4-4m4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="font-mono text-[0.7rem] text-ink-300"><%= case_study.role %> · <%= case_study.status %></span>
      </div>
    </div>
  </div>
</article>
