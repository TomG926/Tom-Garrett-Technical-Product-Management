<% content_for :title, "About" %>
<% content_for :description, "Tom Garrett — technical product leader. Technical Product & Engineering Director at DepositCloud, founder of DocuDynamics, adviser to early-stage Irish companies." %>

<%# ── Intro ──────────────────────────────────────────────────────────────── %>
<section class="mx-auto max-w-6xl px-6 pt-20 pb-16 sm:px-8 sm:pt-28">
  <p class="eyebrow">About</p>

  <div class="mt-6 grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-20">
    <div>
      <h1 class="max-w-3xl font-display text-[2.4rem] font-semibold leading-[1.05] tracking-tight text-ink-950 sm:text-[3.4rem]">
        Ten years across architecture, design and platform ownership
      </h1>

      <div class="mt-8 max-w-2xl space-y-4 text-[1.06rem] leading-relaxed text-ink-500">
        <p>
          I'm a technical product leader working at the intersection of scalable software
          architecture, UX design and platform ownership. I lead product and engineering at
          <span class="font-medium text-ink-900">DepositCloud</span>, a regulated US
          rental-payments platform serving 250,000+ customers, where I own the roadmap across
          three applications — discovery, prioritisation and release planning with a distributed
          team of eight engineers.
        </p>
        <p>
          I've scaled multi-tenant B2B SaaS to 250k+ users, designed the enterprise API ecosystem
          that unlocks the accounts above it, and run data-led discovery to decide what deserves
          to ship. I founded <span class="font-medium text-ink-900">DocuDynamics</span> and took
          it from idea to funded MVP in five months, and I advise early-stage Irish companies on
          product.
        </p>
        <p>
          I work the full cycle: discovery and user research, prototyping, experimentation,
          and shipping. Doing the design and the code alongside the roadmap means system
          constraints become a roadmap, rather than surfacing after one has been agreed.
        </p>
      </div>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="<%= contact[:cv] %>" download
           class="inline-flex items-center gap-2 rounded-full bg-ink-950 px-5 py-2.5 text-[0.92rem] font-medium text-paper transition hover:bg-ink-700">
          Download CV
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M10 3.5v10m0 0 3.5-3.5M10 13.5 6.5 10M4 16.5h12" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="mailto:<%= contact[:email] %>"
           class="inline-flex items-center gap-2 rounded-full border border-ink-200 px-5 py-2.5 text-[0.92rem] font-medium text-ink-900 transition hover:border-ink-950">
          <%= contact[:email] %>
        </a>
      </div>
    </div>

    <aside class="lg:pt-3">
      <p class="eyebrow">Details</p>
      <dl class="mt-4 space-y-4 text-[0.93rem]">
        <div><dt class="text-ink-400">Based</dt><dd class="text-ink-900"><%= contact[:location] %></dd></div>
        <div><dt class="text-ink-400">Currently</dt><dd class="text-ink-900">Technical Product &amp; Engineering Director, DepositCloud</dd></div>
        <div><dt class="text-ink-400">Also</dt><dd class="text-ink-900">Product consultant &amp; adviser, 2024 – present</dd></div>
        <div>
          <dt class="text-ink-400">Links</dt>
          <dd class="space-y-1">
            <a class="link-underline block text-ink-900" href="<%= contact[:linkedin] %>" rel="noopener"><%= contact[:linkedin_label] %></a>
            <a class="link-underline block text-ink-900" href="<%= contact[:site] %>" rel="noopener"><%= contact[:site_label] %></a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<%# ── Skillset ───────────────────────────────────────────────────────────── %>
<section class="border-t border-ink-100 bg-panel">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-8">
    <p class="eyebrow">Product &amp; technical skillset</p>
    <div class="mt-10 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      <% [
           ["Product strategy &amp; delivery", "Agile planning, multi-phase initiative scoping, cross-timezone execution, stakeholder management."],
           ["Discovery &amp; validation", "User research, UX prototyping, Hotjar and session analysis, data-led decisions on which features to kill and which to scale."],
           ["Platform &amp; ecosystems", "API contract design, developer experience, feature flags (Flipper), analytics instrumentation."],
           ["Regulated domains", "US FinTech and PropTech, SOC 2 Type I, security and performance treated as product constraints."],
           ["Core technical fluency", "Ruby on Rails, React, Node, SQL/PostgreSQL, GCP and AWS infrastructure, CI/CD pipelines, system architecture."],
           ["API integrations", "Stripe, Salesforce, Yardi, Entrata, RealPage, Rent Manager, Twilio."]
         ].each do |title, body| %>
        <div>
          <h2 class="font-display text-[1.08rem] font-semibold text-ink-950"><%= title.html_safe %></h2>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-500"><%= body %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── Experience ─────────────────────────────────────────────────────────── %>
<section class="border-t border-ink-100">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-8">
    <p class="eyebrow">Experience</p>

    <div class="mt-12 space-y-16">
      <%
        roles = [
          {
            org: "DepositCloud",
            note: "Ireland (US market) — multi-tenant Rails SaaS managing the full US rental security-deposit lifecycle for property management companies and multifamily operators.",
            titles: [["Technical Product &amp; Engineering Director", "Aug 2025 – Present"], ["Lead Technical Product Engineer", "Jun 2024 – Aug 2025"]],
            points: [
              "Define and execute the product roadmap across three applications serving 250k+ customers (85k+ active accounts, 160k+ enrollments onboarding), aligning a distributed team of 8 engineers on daily priority frameworks and release cycles.",
              "Partnered with company leadership to translate strategic business objectives into rapid-prototype product mockups, using production data to validate core user journeys before full rollout.",
              "Transformed deployment strategy by introducing feature flags tied to analytics (Flipper), establishing measurable launch metrics that make every release a strategic product decision.",
              "Scoped, designed and launched a Twilio-based communication platform in under three months, reducing average operational handling time and eliminating 100% of third-party vendor licensing costs.",
              "Owned the product lifecycle for a greenfield PMS Sync &amp; Integration product, architecting bi-directional APIs with Yardi, Entrata, RealPage and Rent Manager to unlock enterprise-tier market accounts.",
              "Sustained a delivery cadence of 900+ merged PRs and 18–25 major multi-phase initiatives over 24 months through structured Agile planning, weekly one-to-ones and clear initiative scoping.",
              "Accelerated product release velocity from two weeks to under four hours by re-engineering automated CI/CD infrastructure (Docker, GitHub Actions), removing deployment blockers for cross-functional agile teams.",
              "Treated security as an essential product requirement, embedding SOC 2 Type I compliance, automated penetration testing and vulnerability mitigation directly into the development roadmap."
            ]
          },
          {
            org: "Product Consultant &amp; Adviser",
            note: "Advisory and hands-on product engineering for early-stage Irish companies.",
            titles: [["Independent", "2024 – Present"]],
            points: [
              "<strong class=\"font-medium text-ink-900\">Guest Nutrition</strong> (2024 – present) — product adviser to an Enterprise Ireland High Potential Start-Up (HPSU); guided product strategy from 0 to 1 and deployed into active industry field trials.",
              "<strong class=\"font-medium text-ink-900\">WealthGuard</strong> (2025 – present) — scoped the product specification and built a robust wealth-management application in Ruby on Rails, now in active production use by 100+ high-net-worth clients."
            ]
          },
          {
            org: "DocuDynamics",
            note: "Compliance-automation startup. End-to-end product development, from customer discovery to production code.",
            titles: [["Founder", "Nov 2022 – Jun 2024"]],
            points: [
              "Designed and launched the entire v1 web application from concept to funded MVP in five months (React, Node, AWS), securing Microsoft for Startups and New Frontiers Phase 2 backing.",
              "Mapped the critical user workflows — document upload → AI pipeline → collaboration — and continuously optimised systemic friction points through direct user discovery sessions.",
              "Cultivated a culture of disciplined experimentation, using real-time production analytics to kill low-engagement features and scale high-value workflows."
            ]
          },
          {
            org: "Penco",
            note: nil,
            titles: [["Digital Operations Manager", "Dec 2019 – Nov 2022"]],
            points: [
              "Managed end-to-end delivery of web and mobile software features, aligning qualitative user research with sprint goals to ship production-ready work inside two-week iterations.",
              "Designed a custom Salesforce CRM integration strategy that eliminated 60% of manual data entry and increased operational capacity by 40%.",
              "Embedded rapid product validation frameworks by introducing Hotjar for user testing, cutting feature evaluation lifecycles by 70%.",
              "Featured in The Sunday Times (Business, Jul 2020) on leadership in helping Irish SMEs build data-driven operations."
            ]
          },
          {
            org: "Earlier roles",
            note: nil,
            titles: [["Design and engineering", "2016 – 2019"]],
            points: [
              "Full Stack Developer, Gambling.com Group, Dublin (Jan – Dec 2019).",
              "User Experience Designer, GRID Finance, Dublin (Jan 2018 – Jan 2019) — journey mapping and application interfaces for an SME lending engine.",
              "Multimedia Designer, Associated Newspapers and Cauldron Recording Studios, Dublin (2016 – 2018)."
            ]
          }
        ]
      %>

      <% roles.each do |role| %>
        <article class="grid gap-6 border-t border-ink-100 pt-8 lg:grid-cols-[15rem_1fr] lg:gap-12">
          <div>
            <h2 class="font-display text-[1.3rem] font-semibold leading-tight text-ink-950"><%= role[:org].html_safe %></h2>
            <div class="mt-3 space-y-1.5">
              <% role[:titles].each do |title, period| %>
                <div>
                  <p class="text-[0.92rem] font-medium text-ink-700"><%= title.html_safe %></p>
                  <p class="font-mono text-[0.7rem] text-ink-400"><%= period %></p>
                </div>
              <% end %>
            </div>
          </div>
          <div>
            <% if role[:note] %>
              <p class="mb-4 max-w-2xl text-[0.9rem] italic leading-relaxed text-ink-400"><%= role[:note].html_safe %></p>
            <% end %>
            <ul class="max-w-3xl space-y-2.5">
              <% role[:points].each do |point| %>
                <li class="grid grid-cols-[0.75rem_1fr] gap-3 text-[0.96rem] leading-relaxed text-ink-500">
                  <span class="mt-[0.72rem] h-px w-2.5 bg-ink-300" aria-hidden="true"></span>
                  <span><%= point.html_safe %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<%# ── Education & recognition ────────────────────────────────────────────── %>
<section class="border-t border-ink-100 bg-panel">
  <div class="mx-auto grid max-w-6xl gap-14 px-6 py-20 sm:px-8 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Education &amp; further study</p>
      <ul class="mt-6 space-y-5">
        <% [
             ["Professional Academy Diploma, Advanced Artificial Intelligence for Business", "UCD Professional Academy · Jul – Nov 2026, in progress"],
             ["BA (Hons), Digital Art", "IADT Dún Laoghaire, NFQ Level 8 · 2013 – 2017, second-class honours (2.1)"],
             ["New Frontiers, Phase 2 — Enterprise Ireland", "TU Dublin · Oct 2022 – Mar 2023"],
             ["Professional Diploma, Digital Marketing", "Waterford Institute of Technology · 2018 – 2019"]
           ].each do |title, detail| %>
          <li>
            <p class="text-[0.98rem] font-medium text-ink-900"><%= title %></p>
            <p class="mt-0.5 text-[0.86rem] text-ink-400"><%= detail %></p>
          </li>
        <% end %>
      </ul>
    </div>

    <div>
      <p class="eyebrow">Recognition</p>
      <ul class="mt-6 space-y-5">
        <% [
             ["New Frontiers Phase 2 recipient", "TU Dublin"],
             ["Microsoft for Startups portfolio", "DocuDynamics"],
             ["The Sunday Times", "Business feature, July 2020 — on how Irish SMEs can become data-driven"]
           ].each do |title, detail| %>
          <li>
            <p class="text-[0.98rem] font-medium text-ink-900"><%= title %></p>
            <p class="mt-0.5 text-[0.86rem] text-ink-400"><%= detail %></p>
          </li>
        <% end %>
      </ul>

      <div class="mt-10 rounded-lg border border-ink-100 p-6">
        <p class="eyebrow">Full CV</p>
        <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-500">
          Two pages, covering everything above with the detail intact.
        </p>
        <a href="<%= contact[:cv] %>" download
           class="mt-5 inline-flex items-center gap-2 rounded-full bg-ink-950 px-4 py-2 text-[0.88rem] font-medium text-paper transition hover:bg-ink-700">
          Download CV (PDF)
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M10 3.5v10m0 0 3.5-3.5M10 13.5 6.5 10M4 16.5h12" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
