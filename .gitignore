# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Vendored gems — restored by `bundle install`, never committed.
/vendor/bundle

# Superseded case-study PDFs. These predate the disclosure pass and still contain
# material deliberately removed from the HTML studies. Never publish them.
/private

# Static build output for GitHub Pages.
/_site

.DS_Store

# Job-application material. The repo is public — it serves the site at
# tomg926.github.io — so cover letters and CVs cut for a named employer stay
# local. The general CV is tracked as HTML here and shipped as
# public/tom-garrett-cv.pdf; every other PDF in cv/ is a render artefact.
/cv/cover-letter*
/cv/tom-garrett-cv-*
/cv/*.pdf
